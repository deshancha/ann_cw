# Full Configuration
MODEL_TYPE=mobilenetv3 # mobilenetv1 mobilenetv3
EPOCHS=15
BATCH_SIZE=16
LEARNING_RATE=0.001
IMG_SIZE=224
SEED=42
WIDTH_MULTIPLIER=0.5 # 1 for max param, paper say 0.5 is ok

# Full Data set (0 = 5040 train and 2160 validation)
MAX_TRAIN_SAMPLES=0
MAX_VAL_SAMPLES=0

# Paths
DATA_DIR=data
MATTING_DATA_DIR=data/matting_human
SEGMENTATION_DATA_DIR=data/supervisely_person
CHECKPOINTS_DIR=model_creation/output/checkpoints
EXPERIMENTS_DIR=model_creation/output/experiments
OUTPUT_DIR=model_creation/output/gen_images
METRICS_DIR=model_creation/output/metrics
LOG_FILE_PATH=logs/app.log

# Logging & Device
LOG_ENABLED=1
DEVICE=mps
