# Quick Test and Validation

MODEL_TYPE=mobilenetv1 # mobilenetv1 mobilenetv3
WIDTH_MULTIPLIER=1.0

# Hyperparams
EPOCHS=3
BATCH_SIZE=8
LEARNING_RATE=0.001
IMG_SIZE=224
SEED=42
DEVICE=mps

# Dataset Subset - for quick run
MAX_TRAIN_SAMPLES=100
MAX_VAL_SAMPLES=20

# Paths
MATTING_DATA_DIR=data/matting_human
CHECKPOINTS_DIR=model_creation/output/checkpoints
EXPERIMENTS_DIR=model_creation/output/experiments
OUTPUT_DIR=model_creation/output/gen_images
METRICS_DIR=model_creation/output/metrics

LOG_ENABLED=1
